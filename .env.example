# ── Backend ─────────────────────────────────────────────────────
# APP_ID and APP_SECRET are optional (unused outside the original build platform)
APP_ID=
APP_SECRET=               # Application secret (used for JWT signing)

# ── Database ───────────────────────────────────────────────────
DATABASE_URL=             # MySQL connection string (mysql://user:pass@host:port/db). A ?ssl-mode=REQUIRED suffix, as managed hosts add, is supported.
DATABASE_CA_CERT=         # Optional: the host's CA certificate (PEM). With it, ssl-mode=REQUIRED also verifies the server; VERIFY_CA/VERIFY_IDENTITY need it.

# ── MailerLite (server-only; never use a VITE_ prefix) ─────────
MAILERLITE_API_TOKEN=       # Generate in MailerLite > Integrations > API
MAILERLITE_GROUP_ID=        # Optional dedicated Website enquiries group ID
