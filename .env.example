# ── Backend ─────────────────────────────────────────────────────
# APP_ID and APP_SECRET are optional (unused outside the original build platform)
APP_ID=
APP_SECRET=               # Application secret (used for JWT signing)

# ── Database ───────────────────────────────────────────────────
DATABASE_URL=             # MySQL connection string (mysql://user:pass@host:port/db)

# ── MailerLite (server-only; never use a VITE_ prefix) ─────────
MAILERLITE_API_TOKEN=       # Generate in MailerLite > Integrations > API
MAILERLITE_GROUP_ID=        # Optional dedicated Website enquiries group ID
